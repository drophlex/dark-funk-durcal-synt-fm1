+    int32_t c1 = dly_buf[(fx.dly_w - ri - 1u) & (DLY_LEN - 1u)];
+    return c0 + (((c1 - c0) * f) >> 8);
+}
+static int32_t tape_sat(int32_t x, int32_t amt)          /* soft: x - x^3 / 3, amt 0..32767 of it */
