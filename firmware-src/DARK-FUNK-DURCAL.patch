+ * The animated eye splash (Dark Funk Durcal Synt, based on Felucca 1.8.2): after the Felucca credit square,
+ * main.c draws it frame by frame for DFD_SPLASH_MS: dots, the ring, the triangle, the tendrils grow, the eye
+ * opens, the title is typed and the music line fades in. Canvas only (two bands: 240 x 124 and 240 x 110),
+ * integer maths, bounded loops. Not with MENU > ANIM OFF or after a crash (main.c). */
+#define DFD_SPLASH_MS 4400u
+static const int16_t DFD_SIN[256] = {0,402,804,1205,1606,2006,2404,2801,3196,3590,3981,4370,4756,5139,5520,5897,6270,6639,7005,7366,7723,8076,8423,8765,9102,9434,9760,10080,10394,10702,11003,11297,11585,11866,12140,12406,12665,12916,13160,13395,13623,13842,14053,14256,14449,14635,14811,14978,15137,15286,15426,15557,15679,15791,15893,15986,16069,16143,16207,16261,16305,16340,16364,16379,16384,16379,16364,16340,16305,16261,16207,16143,16069,15986,15893,15791,15679,15557,15426,15286,15137,14978,14811,14635,14449,14256,14053,13842,13623,13395,13160,12916,12665,12406,12140,11866,11585,11297,11003,10702,10394,10080,9760,9434,9102,8765,8423,8076,7723,7366,7005,6639,6270,5897,5520,5139,4756,4370,3981,3590,3196,2801,2404,2006,1606,1205,804,402,0,-402,-804,-1205,-1606,-2006,-2404,-2801,-3196,-3590,-3981,-4370,-4756,-5139,-5520,-5897,-6270,-6639,-7005,-7366,-7723,-8076,-8423,-8765,-9102,-9434,-9760,-10080,-10394,-10702,-11003,-11297,-11585,-11866,-12140,-12406,-12665,-12916,-13160,-13395,-13623,-13842,-14053,-14256,-14449,-14635,-14811,-14978,-15137,-15286,-15426,-15557,-15679,-15791,-15893,-15986,-16069,-16143,-16207,-16261,-16305,-16340,-16364,-16379,-16384,-16379,-16364,-16340,-16305,-16261,-16207,-16143,-16069,-15986,-15893,-15791,-15679,-15557,-15426,-15286,-15137,-14978,-14811,-14635,-14449,-14256,-14053,-13842,-13623,-13395,-13160,-12916,-12665,-12406,-12140,-11866,-11585,-11297,-11003,-10702,-10394,-10080,-9760,-9434,-9102,-8765,-8423,-8076,-7723,-7366,-7005,-6639,-6270,-5897,-5520,-5139,-4756,-4370,-3981,-3590,-3196,-2801,-2404,-2006,-1606,-1205,-804,-402};
+#define DFD_S(a) ((int32_t)DFD_SIN[(uint32_t)(a) & 255u])
+#define DFD_C(a) ((int32_t)DFD_SIN[((uint32_t)(a) + 64u) & 255u])
+static uint32_t dfd_isqrt(uint32_t v)
+{
+    uint32_t r = 0, b = 1u << 30;
+    while (b > v)
+        b >>= 2;
+    while (b) {
+        if (v >= r + b) { v -= r + b; r = (r >> 1) + b; }
+        else r >>= 1;
+        b >>= 2;
+    }
+    return r;
+}
+static int32_t dfd_ease(int32_t t, int32_t t0, int32_t len)       /* 0..256, eased out */
+{
+    int32_t u;
+    if (t <= t0) return 0;
+    if (t >= t0 + len) return 256;
+    u = 256 - (t - t0) * 256 / len;
+    return 256 - u * u / 256 * u / 256;
+}
+static void dfd_dot(int32_t x, int32_t y, int32_t th, uint16_t c)
+{
+    cv_rect(x - th / 2, y - th / 2, th, th, c);
+}
+static void dfd_line(int32_t x0, int32_t y0, int32_t x1, int32_t y1, int32_t th, uint16_t c)
+{
+    int32_t dx = x1 > x0 ? x1 - x0 : x0 - x1, sx = x0 < x1 ? 1 : -1;
+    int32_t dy = y1 > y0 ? y0 - y1 : y1 - y0, sy = y0 < y1 ? 1 : -1;
+    int32_t err = dx + dy, guard = 600;
+    while (guard--) {
+        int32_t e2 = 2 * err;
+        dfd_dot(x0, y0, th, c);
+        if (x0 == x1 && y0 == y1) break;
+        if (e2 >= dy) { err += dy; x0 += sx; }
+        if (e2 <= dx) { err += dx; y0 += sy; }
+    }
+}
+static void dfd_disc(int32_t cx, int32_t cy, int32_t r, uint16_t c)
+{
+    int32_t dy;
+    for (dy = -r; dy <= r; dy++) {
+        int32_t w = (int32_t)dfd_isqrt((uint32_t)(r * r - dy * dy));
+        cv_rect(cx - w, cy + dy, 2 * w + 1, 1, c);
+    }
+}
+/* an arc of the circle from the top, `upto` of 256, dashed when dash */
+static void dfd_ring(int32_t cx, int32_t cy, int32_t r, int32_t upto, int32_t dash, int32_t rot, int32_t th, uint16_t c)
+{
+    int32_t i;
+    for (i = 0; i < upto && i < 256; i += 4) {
+        int32_t a = i - 64 + rot;
+        if (dash && ((i >> 3) & 1)) continue;
+        dfd_line(cx + r * DFD_C(a) / 16384, cy + r * DFD_S(a) / 16384, cx + r * DFD_C(a + 4) / 16384,
+                 cy + r * DFD_S(a + 4) / 16384, th, c);
+    }
+}
+static void dfd_text_c(int32_t y, const aafont_t *f, const char *s, uint16_t fg, uint16_t bg)
+{
+    int32_t w = text_w(f, s);
+    cv_text_on((240 - w) / 2, y, f, s, fg, bg);
+}
+static __attribute__((unused)) void draw_splash_frame(uint32_t tms)
+{
+    int32_t t = (int32_t)tms, cx = 120, cy = 62, r = 42, k, side;
+    int32_t ring = dfd_ease(t, 150, 650), tri = dfd_ease(t, 450, 700), grow = dfd_ease(t, 700, 800);
+    int32_t open = dfd_ease(t, 1250, 450), flash = t > 1550 && t < 2100 ? (2100 - t) * 256 / 550 : 0;
+    uint16_t bone = T_TEXT, bg = T_BG, faint = ux_mix(T_BG, T_TEXT, 30), red = T_REC;
+    /* ------------------------------------------------ band 1: the sigil and the eye (240 x 124 at y 4) */
+    cv_begin(240, 124, bg);
+    if (flash > 0)
+        dfd_disc(cx, cy, r + 10 + flash / 32, ux_mix(T_BG, T_TEXT, 6 + flash / 40));
+    for (k = 0; k < 18 && k * 70 < t; k++) {                             /* the dots */
+        int32_t a = k * 256 / 18 - 64, rr = r + 18;
+        dfd_dot(cx + rr * DFD_C(a) / 16384 * 3 / 2, cy + rr * DFD_S(a) / 16384, k % 3 ? 2 : 4, faint);
+    }
+    if (grow > 0)                                                         /* the tendrils, tapered */
+        for (side = -1; side <= 1; side += 2)
+            for (k = 0; k < 5; k++) {
+                int32_t y0 = (k - 2) * 15, len = (68 - (k == 2 ? 0 : 8) - (k == 0 || k == 4 ? 10 : 0)) * grow / 256, j, px = 0, py = 0;
+                for (j = 0; j <= 10; j++) {
+                    int32_t u = j * 256 / 10, x = cx + side * (r + 6 + len * j / 10);
+                    int32_t wob = DFD_S(j * 20 + (t >> 3) + k * 40) * 4 * u / 256 / 16384;
+                    int32_t y = cy + y0 * (128 + u / 2) / 192 + wob, th = 5 - (j * 4) / 10 - (k == 2 ? 0 : 1);
+                    if (th < 1) th = 1;
+                    if (j) dfd_line(px, py, x, y, th, k == 2 ? bone : faint);
+                    px = x; py = y;
+                }
+            }
+    dfd_disc(cx, cy, r - 1, bg);
+    dfd_ring(cx, cy, r + 6, ring, 1, t / 40, 3, bone);                  /* the dashed outer ring, turning */
+    dfd_ring(cx, cy, r - 2, ring, 0, 0, 1, faint);
+    if (tri > 0) {                                                        /* the triangle, drawn side by side */
+        int32_t P[4][2] = {{cx, cy - r + 1}, {cx + r * 87 / 100, cy + r / 2}, {cx - r * 87 / 100, cy + r / 2}, {cx, cy - r + 1}};
+        int32_t done = tri * 3, s2;
+        for (s2 = 0; s2 < 3 && done > 0; s2++) {
+            int32_t u = done > 256 ? 256 : done;
+            dfd_line(P[s2][0], P[s2][1], P[s2][0] + (P[s2 + 1][0] - P[s2][0]) * u / 256,
+                     P[s2][1] + (P[s2 + 1][1] - P[s2][1]) * u / 256, 3, bone);
+            done -= 256;
+        }
+    }
+    {   /* the eye: lids (two parabolas), the iris and pupil inside them */
+        int32_t W = 26, H = 1 + 15 * open / 256, x, y;
+        int32_t ix = cx + (open > 200 ? (DFD_S(t >> 4) * 4 / 16384) : 0), ir = 10, pr = 4 + flash / 64;
+        for (y = -ir; y <= ir; y++)                                       /* the iris, clipped by the lids */
+            for (x = -ir; x <= ir; x++) {
+                int32_t d2 = x * x + y * y, ax = ix + x - cx, lim;
+                if (d2 > ir * ir) continue;
+                if (ax < -W || ax > W) continue;
+                lim = H * (W * W - ax * ax) / (W * W);
+                if (y > lim || y < -lim) continue;
+                cv_pset(ix + x, cy + y, d2 > (ir - 2) * (ir - 2) ? bone : (d2 <= pr * pr ? (d2 <= 2 ? bg : bone) : (flash > 64 ? red : bg)));
+            }
+        for (x = -W; x < W; x += 2) {                                     /* the lids */
+            int32_t y0 = H * (W * W - x * x) / (W * W), y1 = H * (W * W - (x + 2) * (x + 2)) / (W * W);
+            dfd_line(cx + x, cy - y0, cx + x + 2, cy - y1, 2, bone);
+            dfd_line(cx + x, cy + y0, cx + x + 2, cy + y1, 2, bone);
+        }
+        if (t > 1700) {                                                   /* the drop below the eye */
+            int32_t dyy = cy + r / 2 + 8 + (t > 2000 ? (t - 2000) / 150 : 0);
+            dfd_disc(cx, dyy, 3, bone);
+            dfd_line(cx, dyy - 6, cx, dyy - 2, 2, bone);
+        }
+    }
+    cv_blit(0, 4);
+    /* ------------------------------------------------ band 2: the words (240 x 110 at y 130) */
+    cv_begin(240, 110, bg);
+    if (t > 1500) {
+        static const char TITLE[] = "DARK FUNK DURCAL";
+        char b[20];
+        int32_t n = (t - 1500) / 45, i;
+        if (n > 16) n = 16;
+        for (i = 0; i < n; i++) b[i] = TITLE[i];
+        b[n] = 0;
+        cv_text_on((240 - text_w(&AF_M, TITLE)) / 2, 2, &AF_M, b, bone, bg);
+    }
+    if (t > 2150)
+        dfd_text_c(22, &AF_M, "S Y N T", t > 2300 ? bone : faint, bg);
+    if (t > 2250 && t < 3500) {                       /* what is it: the music, everywhere */
+        uint16_t c = t > 2450 ? ux_mix(T_BG, T_TEXT, 75) : faint;
+        cv_rect(40, 43, 160, 1, faint);
+        dfd_text_c(50, &AF_S, "WHAT IS DARK FUNK DURCAL?", t > 2450 ? bone : faint, bg);
+        dfd_text_c(66, &AF_S, "SEARCH IT ON SPOTIFY, YOUTUBE", c, bg);
+        dfd_text_c(80, &AF_S, "AND EVERY AUDIO PLATFORM", c, bg);
+    }
+    if (t >= 3500) {                                  /* who made it */
+        uint16_t c = t > 3700 ? bone : faint;
+        cv_rect(40, 43, 160, 1, faint);
+        dfd_text_c(48, &AF_S, "CREATED AT POLARIS SOUND LAB", c, bg);
+        dfd_text_c(63, &AF_S, "MERIDA, YUCATAN, MEXICO", t > 3700 ? ux_mix(T_BG, T_TEXT, 70) : faint, bg);
+        dfd_text_c(80, &AF_S, "INSTAGRAM @polaris.sound.lab", t > 3700 ? red : faint, bg);
+        dfd_text_c(95, &AF_S, "YOUTUBE @PolarisSoundLab", t > 3700 ? red : faint, bg);
+    }
+    cv_blit(0, 130);
+    lcd_sync();
+}
