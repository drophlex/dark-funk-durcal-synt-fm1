+/* TAPE ECHO (Dark Funk Durcal): the delay as a three-head tape loop (the spring-and-tape echoes of the 70s). MENU-free:
+ * the FX family's TAPE ECHO page, G_DRLVL (HEADS: OFF H1 H2 H3 H1+2 H2+3 H1+3 ALL) and G_DRREV (WOW 0..127: wow, flutter
+ * and tape saturation). HEADS OFF: the delay bit for bit as before. The heads at TIME x1 x2 x3 (the 3 limited to the
+ * line), read between samples while the wow (~0.6 Hz) and the flutter (~6 Hz) move the tape; the repeats come back
+ * through the low-pass COLOR, a ~150 Hz high-pass (the thin tape) and a soft saturation, so a high FDBK self-oscillates
+ * but stays bounded (the line is int16, the sum is the mean of the heads) */
+static const uint8_t TAPE_HEADS[8] = {0, 1, 2, 4, 3, 6, 5, 7};
+static uint32_t tape_wow_ph, tape_flt_ph;
+static int32_t tape_hp;
+static int32_t tape_read(uint32_t dq8)                   /* the line dq8 / 256 samples back */
+{
+    uint32_t ri = dq8 >> 8;
+    int32_t f = (int32_t)(dq8 & 255u), c0 = dly_buf[(fx.dly_w - ri) & (DLY_LEN - 1u)];
+    int32_t c1 = dly_buf[(fx.dly_w - ri - 1u) & (DLY_LEN - 1u)];
+    return c0 + (((c1 - c0) * f) >> 8);
+}
+static int32_t tape_sat(int32_t x, int32_t amt)          /* soft: x - x^3 / 3, amt 0..32767 of it */
+{
+    int32_t c;
+    x = clamp(x, -32767, 32767);
+    c = ((x * x) >> 15) * x >> 15;
+    return x - mulq15(c / 3, amt);
+}
+static __attribute__((noinline)) void tape_echo(const int32_t *dly_in, int32_t *wet, uint32_t n, uint32_t dl, int32_t fb,
+                                                int32_t col, int32_t dmix)
+{
+    uint32_t i, m = TAPE_HEADS[song.g[G_DRLVL] & 7], top = m & 4u ? 3u : m & 2u ? 2u : 1u, nh, h;
+    int32_t wow = clamp(song.g[G_DRREV], 0, 127), wdep = wow * 20 * 256 / 127, fdep = wow * 3 * 256 / 127;
+    int32_t sat = 6000 + wow * 200, hscale;
+    uint32_t base = dl * top < DLY_LEN - 64u ? dl : (DLY_LEN - 64u) / top;
+    nh = (m & 1u) + ((m >> 1) & 1u) + ((m >> 2) & 1u);
+    hscale = nh == 1u ? 32767 : nh == 2u ? 23170 : 18918;   /* 1, 1/sqrt 2, 1/sqrt 3 */
+    for (i = 0; i < n; i++) {
+        int32_t mod = (osc_sine(tape_wow_ph) * wdep >> 15) + (osc_sine(tape_flt_ph) * fdep >> 15), sum = 0, x, fbs;
+        tape_wow_ph += 58447u;                       /* 0.6 Hz */
+        tape_flt_ph += 557000u;                      /* 5.7 Hz */
+        for (h = 0; h < 3u; h++)
+            if (m >> h & 1u) {
+                int32_t d = (int32_t)(base * (h + 1u) << 8) + mod * (int32_t)(h + 1u);
+                sum += tape_read((uint32_t)clamp(d, 16 << 8, (int32_t)(DLY_LEN - 4u) << 8));
+            }
+        x = mulq15(sum, hscale);                     /* heard: 1, 1/sqrt 2, 1/sqrt 3 of the heads */
+        sum = nh == 1u ? sum : nh == 2u ? sum >> 1 : mulq15(sum, 10923);   /* fed back: their mean (loop gain < 1) */
+        fx.dly_lp += mulq15(sum - fx.dly_lp, col);
+        tape_hp += (fx.dly_lp - tape_hp) >> 6;       /* ~110 Hz */
+        fbs = fx.dly_lp - tape_hp;
+        dly_buf[fx.dly_w & (DLY_LEN - 1u)] =
+            (int16_t)clamp(tape_sat((dly_in[i] >> 1) + mulq15(fbs, fb), sat), -32768, 32767);
+        fx.dly_w++;
+        wet[i] += mulq15(x << 1, dmix);
+    }
+}
